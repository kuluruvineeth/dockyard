{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "openapi-typescript ../openapi/schema.yml -o app/api/v1.ts",
    "build": "NODE_ENV=production react-router build",
    "dev": "react-router dev --host",
    "preview": "vite preview --port 5173 --host",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "^7.17.0",
    "@react-router/serve": "^7.17.0",
    "@tanstack/query-sync-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "clsx": "^2.1.1",
    "isbot": "^5.1.17",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.17.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@react-router/dev": "^7.17.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "openapi-typescript": "^6.7.4",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-babel": "^1.3.2",
    "vite-tsconfig-paths": "^5.1.4"
