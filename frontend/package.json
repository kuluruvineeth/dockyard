{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "openapi-typescript ../openapi/schema.yml -o app/api/v1.ts",
    "build": "NODE_ENV=production react-router build",
    "dev": "react-router dev --host",
    "preview": "vite preview --port 5173 --host",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "^7.17.0",
    "@react-router/serve": "^7.17.0",
    "isbot": "^5.1.17",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.17.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@react-router/dev": "^7.17.0",
    "@types/node": "^20",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "openapi-typescript": "^6.7.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-babel": "^1.3.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
